{
  "name": "lunar-navigator-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "build": "npm run type-check && vite build",
    "lint": "eslint .",
    "format": "prettier --write src/ vite.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/vue": "^1.65.0",
    "axios": "^1.8.2",
    "clsx": "^2.1.1",
    "pinia": "^3.0.1",
    "primevue": "^4.3.0",
    "tailwind-merge": "^3.0.0",
    "three": "^0.187.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.0",
    "@tsconfig/node22": "^22.0.0",
    "@types/node": "^22.0.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-typescript": "^14.0.0",
    "@vue/tsconfig": "^0.8.0",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.0.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
